+// Reading a source file during bundling is observable on Linux. Treating
+// access/open/close-read events as edits causes an endless rebuild loop.
+fn project_event_changes_files(kind: &notify::EventKind) -> bool {
+    !matches!(kind, notify::EventKind::Access(_))
+}
+
 fn ignored_project_path(project: &Path, path: &Path) -> bool {
     const IGNORED_DIRECTORIES: &[&str] = &[
         ".cache",
@@ -619,3 +626,35 @@ async fn stop_child(child: &mut Child, internal: Option<&str>) {
         let _ = child.kill().await;
     }
 }
+
+#[cfg(test)]
+mod watcher_tests {
+    use super::project_event_changes_files;
+    use notify::event::{AccessKind, AccessMode, CreateKind, ModifyKind, RemoveKind, RenameMode};
+    use notify::EventKind;
+
+    #[test]
+    fn source_reads_do_not_trigger_rebuilds() {
+        for kind in [
+            AccessKind::Any,
+            AccessKind::Read,
+            AccessKind::Open(AccessMode::Read),
+            AccessKind::Close(AccessMode::Read),
+        ] {
+            assert!(!project_event_changes_files(&EventKind::Access(kind)));
+        }
+    }
+
+    #[test]
+    fn edits_and_atomic_saves_still_trigger_rebuilds() {
+        for kind in [
+            EventKind::Any,
+            EventKind::Create(CreateKind::File),
+            EventKind::Modify(ModifyKind::Any),
+            EventKind::Modify(ModifyKind::Name(RenameMode::Both)),
+            EventKind::Remove(RemoveKind::File),
+        ] {
+            assert!(project_event_changes_files(&kind));
+        }
+    }
+}
